{
  "project_name": "Stellar Jarvis",
  "version": "1.0.0",
  "endpoints": {
    "local_ollama": {
      "base_url": "http://localhost:11434/v1",
      "default_model": "qwen2.5-coder:1.5b",
      "fallback_model": "llama3.2",
      "cost_per_1k_tokens": 0.0
    },
    "gemini": {
      "model": "gemini-3.6-flash",
      "use_case": "large_context_orchestration"
    },
    "claude": {
      "model": "claude-3-5-sonnet",
      "use_case": "precision_copy_and_grant_writing"
    }
  },
  "subagents": {
    "grant_assistant": {
      "enabled": true,
      "primary_model": "claude",
      "fallback_model": "local_ollama"
    },
    "cloud_architect": {
      "enabled": true,
      "primary_model": "gemini",
      "aws_enabled": true,
      "azure_enabled": true
    },
    "growth_social": {
      "enabled": true,
      "primary_model": "local_ollama"
    }
  }
}
